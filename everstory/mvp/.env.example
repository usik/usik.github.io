# Configure secrets through the hosting secret manager. Never commit real values.
# Production: authenticated Sites -> Supabase Edge Function -> PostgreSQL/Gemini.
EVERSTORY_BACKEND_URL=
EVERSTORY_BACKEND_TOKEN=
# Production Gemini key is a Sites runtime secret, forwarded only over the authenticated server-to-server request.
# Optional direct-development backend:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PUBLIC_ORIGIN=https://everstory.usik-luke.chatgpt.site
SERVICE_ENABLED=false
# Canonical origin for SEO, sitemap and structured data. Change only after DNS/TLS are ready.
PUBLIC_SITE_URL=https://everstory.usik-luke.chatgpt.site
# Exact old hostnames, comma-separated; enable 308 redirects only during a verified domain migration.
LEGACY_SITE_HOSTS=
# Secret, trusted sign-in email list used only to exclude operator analytics.
ANALYTICS_OPERATOR_EMAILS=
